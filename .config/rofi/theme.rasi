* {
    font: "Adwaita Sans 13";
    background-color: transparent;
    text-color: #cdd6f4ff;
}

window {
    background-color: #1e1e2ecc;
    border: 4px;
    border-color: #56ffcfff;
    /* 【修改1】窗口圆角改为0，变成直角 */
    border-radius: 0px;
    /* 【修改2】宽度加大，容纳两列（原来是35ch，建议改成60ch或按需调整） */
    width: 60ch;          
    padding: 15px 40px;
}

mainbox {
    background-color: transparent;
    spacing: 5px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: transparent;
    spacing: 5px;
    padding: 0px;
}

prompt {
    background-color: transparent;
    text-color: #74c7ecff;
    padding: 0px 5px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: #89dcebff;
    placeholder-color: #74c7ecff;
}

listview {
    background-color: transparent;
    /* 【修改3】原本是 lines: 9; 改成 6 左右比较适合两列布局 */
    lines: 6;             
    /* 【修改4】开启两列显示 */
    columns: 2;           
    padding: 0px;
    spacing: 5px;
}

element {
    background-color: transparent;
    text-color: #cdd6f4ff;
    padding: 6px 5px;
    /* 【修改5】选中项的圆角也改成直角 */
    border-radius: 0px;   
}

element selected {
    background-color: #56ffcfe6;
    text-color: #1e1e2eff;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold #74c7ecff;
}

element-text selected {
    text-color: #1e1e2eff;
    highlight: bold #1e1e2eff;
}

element-icon {
    background-color: transparent;
    size: 1.2em;
}

